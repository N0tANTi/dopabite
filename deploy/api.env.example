APP_ORIGIN=https://food.archein.site
PORT=8787
DOPABITE_DATABASE_PATH=/srv/dopabite-data/dopabite.sqlite3
DOPABITE_BACKUP_PATH=/srv/dopabite-data/backups
DOPABITE_BACKUP_RETENTION=7
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Preferred: Tencent Cloud SES API template delivery.
# Keep credentials on the API server only. Never expose them to Vite or Git.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM=DopaBite <no-reply@example.com>
TENCENT_SES_TEMPLATE_ID=

# Optional fallback: SMTP delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DopaBite <no-reply@example.com>
