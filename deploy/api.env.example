APP_ORIGIN=https://food.archein.site
PORT=8787
DOPABITE_DATABASE_PATH=/srv/dopabite-data/dopabite.sqlite3
DOPABITE_BACKUP_PATH=/srv/dopabite-data/backups
DOPABITE_BACKUP_RETENTION=7
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Optional: configure SMTP to enable passwordless email-code login.
# These values belong on the API server only and must never be exposed to Vite.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DopaBite <no-reply@example.com>
