[Unit]
Description=Create and verify DopaBite SQLite snapshot
After=dopabite-api.service

[Service]
Type=oneshot
User=anti
Group=anti
WorkingDirectory=/srv/dopabite-api/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/dopabite/api.env
ExecStart=/usr/bin/node dist-server/backup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/dopabite-data
